  (text "Blue Pill plugs into two 1x20 female headers, 15.24 mm (0.6 in) apart. USB (micro-USB on the Blue Pill) goes to the PC: USB CDC for the Python UI."
    (at 25 110.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 322550b8-3636-4778-93d3-a52a932adb5d))
  (text "D801 stops the 5 V rail from back-feeding the PC USB port (the Blue Pill 5V pin is tied to VBUS)."
    (at 25 114.5 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid f3984d51-62fc-47fe-ae5e-4aefd629e9f5))
  (text "Pins: PA0 I_MON, PA1 V_FAST (ADC) | PB6/PB7 I2C1 | PB12 K1_EN, PB13 K2_EN | PB14 LOAD_OFF | PB15 FAULT_N (open-drain, read + force) |"
    (at 25 119.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 8c8ac8d6-fdb1-4e81-90d3-ac5133ef4acf))
  (text "PB0/PB1 TIM3 TEC_RPWM/LPWM, PB10 TEC_EN | PA8 TIM1 FAN_PWM | PA9/PA10 debug UART | PA11/PA12 USB (on board)."
    (at 25 123.5 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid d734cbc2-5db2-419d-9451-10bed897efae))
  (text "R801/R802: I2C pull-ups. Fit only if the modules do not already have them."
    (at 25 128.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 2396173d-e1b5-4a7d-960b-75ceb6a8abfc)))
