	(text "Q601 inverts FAULT_N -> FAULT (active high), which kills the load setpoint, both relay gates and the Peltier driver enable."
		(exclude_from_sim no)
		(at 25 221 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1c0270c0-2fb2-438b-92f5-99bb5c463d26")
	)
	(text "Trips: OV cell > ~4.29 V | UV cell < ~1.95 V | OC discharge > ~11 A | OC charge > ~6.4 A | heatsink or cell NTC > ~62 C."
		(exclude_from_sim no)
		(at 25 216.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "211ee783-2adb-4435-977a-9712f9b052f5")
	)
	(text "UV also trips with no cell inserted (shows as \"no cell\"). Add ~10 mV hysteresis resistors later if the comparators chatter."
		(exclude_from_sim no)
		(at 25 230 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "227b5b09-7fe4-4980-a7e8-cda8c8bf1919")
	)
	(text "The MCU reads FAULT_N on PB15 and can also pull it low (open-drain) to force a safe stop and latch the fault in firmware."
		(exclude_from_sim no)
		(at 25 225.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "473f2689-9d24-425f-bbe2-3ce6bc979137")
	)
	(text "VREF = 2.5 V from TL431 (U603). Comparators run from +5 V, open-collector outputs wired-OR onto FAULT_N (pull-up to 3V3)."
		(exclude_from_sim no)
		(at 25 212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "48793de3-e277-4b2f-8b88-00ed88733954")
	)
