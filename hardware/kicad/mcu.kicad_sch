  (text "Blue Pill plugs into two 1x20 female headers. USB (micro-USB on the Blue Pill) goes to the PC: USB CDC for the Python UI."
    (at 25 110.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 219321aa-a3cd-4658-8990-cb614860cb0a))
  (text "D801 stops the 5 V rail from back-feeding the PC USB port (the Blue Pill 5V pin is tied to VBUS)."
    (at 25 114.5 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 2a621ea1-5950-49f8-a87f-43e519d9c8a1))
  (text "Pins: PA0 I_MON, PA1 V_FAST (ADC) | PB6/PB7 I2C1 | PB12 K1_EN, PB13 K2_EN | PB14 LOAD_OFF | PB15 FAULT_N (open-drain, read + force) |"
    (at 25 119.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 8a0a082b-1be5-4c94-aa9a-db24dbe383be))
  (text "PB0/PB1 TIM3 TEC_RPWM/LPWM, PB10 TEC_EN | PA8 TIM1 FAN_PWM | PA9/PA10 debug UART | PA11/PA12 USB (on board)."
    (at 25 123.5 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 730ee684-86b7-43e8-b1ac-44d026b2b4e3))
  (text "R801/R802: I2C pull-ups. Fit only if the modules do not already have them."
    (at 25 128.0 0)
    (effects
      (font
        (size 1.27 1.27))
      (justify left top))
    (uuid 24de244a-86fd-4679-b62f-86496d0e98a5)))
